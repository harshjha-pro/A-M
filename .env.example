# A&M Wedding — copy to private/.env on Hostinger and fill in.
# Never upload a filled .env into a ZIP, chat or Git. Permission 600.
APP_ENV=staging                    # live | staging | test
APP_URL=https://staging-wedding.lumorrahouse.com   # live: https://wedding.lumorrahouse.com
APP_NAME="A&M Wedding"

DB_HOST=localhost
DB_PORT=3306
DB_NAME=u000000000_amstaging       # live: u000000000_amlive
DB_USER=u000000000_amstaging
DB_PASS=change-me

STORAGE_ROOT=/home/u000000000/domains/staging-wedding.lumorrahouse.com/private/storage   # holds uploads/ and exports/
LOG_DIR=/home/u000000000/domains/staging-wedding.lumorrahouse.com/private/logs
STORAGE_QUOTA_BYTES=53687091200    # 50 GB plan (API §11)
DB_QUOTA_BYTES=3221225472          # 3 GB per database

SETUP_TOKEN=change-me-long-random  # one-time owner creation (API §3.2, Session 2). Delete after use.
TRUSTED_PROXY=                     # leave empty unless Session 4 proves Hostinger sends a forwarding header (then put its name, e.g. X-Forwarded-For)
MIN_CLIENT_VERSION=1.0.0           # older phones get "Please close and reopen the app"

# Health: "backup" check. false until the nightly backup job exists (live, Session 4). Then true, for ever.
BACKUP_EXPECTED=false

MAIL_ENABLED=false                 # password-reset emails (off at launch, CONTEXT 29)
ALERTS_ENABLED=true                # backup / error-digest emails to the couple (Session 4)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=planner@lumorrahouse.com
SMTP_PASS=change-me
MAIL_FROM=planner@lumorrahouse.com
MAIL_FROM_NAME="A&M Wedding"
ALERT_TO=ayush@example.com,mahi@example.com
MAIL_DAILY_CAP=30

# R2a (Session 15)
VAPID_SUBJECT=mailto:planner@lumorrahouse.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
